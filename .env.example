# LegalCitation — Environment Variables
# Copy this to .env and fill in your values

# Required: Anthropic API key for Claude verification
ANTHROPIC_API_KEY=

# Database (Railway PostgreSQL or Neon)
DATABASE_URL=

# Redis (Upstash)
REDIS_URL=

# Auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
JWT_SECRET=

# Server
PORT=3001
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# Frontend (set in Vercel if not using vercel.json rewrites)
# VITE_API_URL=https://your-railway-api.up.railway.app/api
