# LegalCitation — Environment Variables
# Copy this to .env and fill in your values

# Required: Anthropic API key for Claude verification
ANTHROPIC_API_KEY=

# CourtListener API token for case law verification (v4)
# Get yours at https://www.courtlistener.com/help/api/rest/
COURTLISTENER_API_TOKEN=

# Database (Railway PostgreSQL or Neon)
DATABASE_URL=

# Redis (Upstash)
REDIS_URL=

# Auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
JWT_SECRET=

# Apple Sign In
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Microsoft Login
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# File storage (S3-compatible, e.g., Cloudflare R2/AWS S3)
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional DB TLS cert (often needed outside Railway internal network)
DATABASE_CA_CERT=

# Server
PORT=3001
CORS_ORIGIN=http://localhost:5173
CORS_ORIGIN_PATTERNS=
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# Database Pool
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONNECTION_TIMEOUT=5000

# Frontend (set in Vercel if not using vercel.json rewrites)
VITE_API_URL=
VITE_GOOGLE_CLIENT_ID=
VITE_APPLE_CLIENT_ID=
VITE_MICROSOFT_CLIENT_ID=
